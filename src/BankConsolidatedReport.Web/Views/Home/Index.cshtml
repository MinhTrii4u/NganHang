@{
    ViewData["Title"] = "Dashboard Quản trị Báo cáo";
}

<!-- ========================================== -->
<!-- TAB 1: BÁO CÁO HỢP NHẤT OLAP                -->
<!-- ========================================== -->
<section class="tab-panel active" id="tab-report">
    <!-- 4 Modern Executive KPI Cards -->
    <div class="kpi-grid">
        <!-- KPI 1: Tổng lợi nhuận ròng -->
        <div class="kpi-card kpi-card-primary">
            <div class="kpi-icon-wrapper icon-emerald">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </div>
            <div class="kpi-details">
                <span class="kpi-title">Tổng Lợi Nhuận Ròng</span>
                <div class="kpi-num-row">
                    <span class="kpi-number text-emerald" id="kpiNetIncome">—</span>
                    <span class="kpi-unit">triệu ₫</span>
                </div>
                <span class="kpi-meta" id="kpiNetIncomeMeta">Tổng toàn hệ thống (Năm 2025)</span>
            </div>
        </div>

        <!-- KPI 2: Số dòng kết quả -->
        <div class="kpi-card">
            <div class="kpi-icon-wrapper icon-blue">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </div>
            <div class="kpi-details">
                <span class="kpi-title">Số Dòng Kết Quả</span>
                <div class="kpi-num-row">
                    <span class="kpi-number text-blue" id="kpiRowCount">—</span>
                    <span class="kpi-unit">dòng</span>
                </div>
                <span class="kpi-meta" id="kpiRowCountMeta">Báo cáo ROLLUP đa cấp</span>
            </div>
        </div>

        <!-- KPI 3: Thời gian thực thi Oracle -->
        <div class="kpi-card">
            <div class="kpi-icon-wrapper icon-purple">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <div class="kpi-details">
                <span class="kpi-title">Thời Gian Truy Vấn</span>
                <div class="kpi-num-row">
                    <span class="kpi-number text-purple" id="kpiExecTime">—</span>
                    <span class="kpi-unit">ms</span>
                </div>
                <span class="kpi-meta">Oracle 23ai SYS_REFCURSOR</span>
            </div>
        </div>

        <!-- KPI 4: Quý đang bị khóa -->
        <div class="kpi-card">
            <div class="kpi-icon-wrapper icon-rose">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <div class="kpi-details">
                <span class="kpi-title">Quý Đang Khóa</span>
                <div class="kpi-num-row">
                    <span class="kpi-number text-rose" id="kpiLockedCount">0</span>
                    <span class="kpi-unit">quý</span>
                </div>
                <span class="kpi-meta" id="kpiLockedMeta">Chưa có quý nào bị khóa</span>
            </div>
        </div>
    </div>

    <!-- Unified Single-Line Control Bar -->
    <div class="control-bar-card">
        <div class="control-left">
            <span class="control-label">Chế độ phân tích:</span>
            <div class="segmented-control" id="modeSegments">
                <button type="button" class="segment-btn active" data-mode="ROLLUP">
                    <span class="seg-title">ROLLUP</span>
                    <span class="seg-badge">Phân cấp</span>
                </button>
                <button type="button" class="segment-btn" data-mode="CUBE">
                    <span class="seg-title">CUBE</span>
                    <span class="seg-badge">Đa chiều</span>
                </button>
                <button type="button" class="segment-btn" data-mode="SETS">
                    <span class="seg-title">GROUPING SETS</span>
                    <span class="seg-badge">Chọn lọc</span>
                </button>
                <button type="button" class="segment-btn" data-mode="PIVOT">
                    <span class="seg-title">PIVOT</span>
                    <span class="seg-badge">Quý thành cột</span>
                </button>
                <button type="button" class="segment-btn" data-mode="PIVOT_DYN">
                    <span class="seg-title">PIVOT Động</span>
                    <span class="seg-badge">Nhóm SP động</span>
                </button>
            </div>
        </div>

        <div class="control-right">
            <div class="year-select-wrap">
                <label for="reportYear" class="control-label">Năm:</label>
                <select id="reportYear" class="custom-select">
                    <option value="2025" selected>2025</option>
                    <option value="2024">2024</option>
                </select>
            </div>

            <button type="button" class="btn btn-primary" id="btnRefreshReport" title="Tải lại dữ liệu">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                <span>Làm mới</span>
            </button>
        </div>
    </div>

    <!-- Analytics Chart Card -->
    <div class="panel-card chart-panel">
        <div class="panel-header">
            <div class="panel-title-group">
                <h3 class="panel-title" id="chartTitle">Biểu Đồ Phân Tích Lợi Nhuận Ròng</h3>
                <span class="panel-subtitle" id="chartSubtitle">So sánh chi tiết từ tập dữ liệu Oracle 23ai</span>
            </div>
            <button class="btn btn-sm btn-ghost" id="btnToggleChart" title="Thu gọn biểu đồ">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="18 15 12 9 6 15"></polyline>
                </svg>
                <span id="chartToggleText">Thu gọn</span>
            </button>
        </div>
        <div class="chart-content" id="chartContent">
            <div class="chart-canvas-container">
                <canvas id="reportChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Financial Data Table Card -->
    <div class="panel-card table-panel">
        <div class="panel-header">
            <div class="panel-title-group">
                <div class="title-with-badge">
                    <h3 class="panel-title">Dữ Liệu Chi Tiết Báo Cáo</h3>
                    <span class="count-badge" id="tableRowCountBadge">49 dòng</span>
                </div>
                <span class="panel-subtitle">Dữ liệu hợp nhất từ package <code>pkg_bank_report.fn_report</code></span>
            </div>

            <div class="panel-actions">
                <div class="search-input-wrap">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" class="search-input" id="tableSearch" placeholder="Lọc chi nhánh, khu vực, quý..." />
                </div>
                <button type="button" class="btn btn-sm btn-outline" id="btnExportCsv" title="Xuất CSV chuẩn UTF-8">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>CSV</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline" id="btnExportExcel" title="Xuất file Excel tương thích UTF-8 BOM">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>Excel</span>
                </button>
            </div>
        </div>

        <div class="table-scroll-wrap" id="tableScrollWrap">
            <!-- Skeleton Loader -->
            <div class="skeleton-container" id="reportSkeleton">
                <div class="sk-row sk-header"></div>
                <div class="sk-row"></div>
                <div class="sk-row"></div>
                <div class="sk-row"></div>
                <div class="sk-row"></div>
                <div class="sk-row"></div>
                <div class="sk-row"></div>
            </div>

            <!-- Table -->
            <table class="financial-table" id="reportTable" style="display:none;">
                <thead id="reportThead"></thead>
                <tbody id="reportTbody"></tbody>
            </table>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- TAB 2: CHỐT KỲ & KIỂM SOÁT KHÓA            -->
<!-- ========================================== -->
<section class="tab-panel" id="tab-lock">
    <div class="panel-intro">
        <h2 class="intro-title">Quản lý Chốt kỳ & Khóa Dữ liệu Tài chính</h2>
        <p class="intro-desc">
            Khi thực hiện Chốt quý, hệ thống tự động khóa <code>LOCK TABLE fact_income IN SHARE MODE WAIT 10</code> và kích hoạt Trigger bảo vệ <code>trg_fact_period_guard</code> để ngăn chặn tuyệt đối mọi hành vi thêm, sửa hoặc xóa dữ liệu của quý đã khóa.
        </p>
    </div>

    <div class="grid-2col">
        <!-- Form Chốt / Mở quý -->
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">Thao tác Chốt / Mở Lại Quý</h3>
                    <span class="panel-subtitle">Gọi thủ tục <code>sp_close_quarter</code> / <code>sp_reopen_quarter</code></span>
                </div>
            </div>
            <div class="panel-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label for="lockYear">Năm tài chính</label>
                        <select id="lockYear" class="custom-select full-width">
                            <option value="2025" selected>2025</option>
                            <option value="2024">2024</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="lockQuarter">Quý</label>
                        <select id="lockQuarter" class="custom-select full-width">
                            <option value="Q1" selected>Quý 1 (Q1)</option>
                            <option value="Q2">Quý 2 (Q2)</option>
                            <option value="Q3">Quý 3 (Q3)</option>
                            <option value="Q4">Quý 4 (Q4)</option>
                        </select>
                    </div>
                </div>

                <div class="alert-info-box">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <span>Mọi thao tác chốt hoặc mở lại kỳ đều được ghi vào bảng <code>period_close_log</code> để phục vụ kiểm toán nội bộ.</span>
                </div>

                <div class="button-row">
                    <button type="button" class="btn btn-danger" id="btnCloseQuarter">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span>Chốt Quý Này</span>
                    </button>
                    <button type="button" class="btn btn-outline" id="btnReopenQuarter">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                        </svg>
                        <span>Mở Lại Quý</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Danh sách quý đang khóa -->
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">Các Quý Đang Được Bảo Vệ</h3>
                    <span class="panel-subtitle">Dữ liệu từ bảng <code>period_close</code></span>
                </div>
                <button type="button" class="btn btn-xs btn-outline" id="btnRefreshClosed">Làm mới</button>
            </div>
            <div class="panel-body">
                <div class="locked-quarters-list" id="closedQuartersList">
                    <div class="empty-state">Đang tải danh sách quý chốt...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng lịch sử chốt / mở lại kỳ -->
    <div class="panel-card mt-4">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">Nhật Ký Chốt / Mở Kỳ (period_close_log)</h3>
                <span class="panel-subtitle">Theo dõi người thực hiện và mốc thời gian</span>
            </div>
        </div>
        <div class="table-scroll-wrap max-h-360">
            <table class="financial-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Năm</th>
                        <th>Quý</th>
                        <th>Hành Động</th>
                        <th>Người Thực Hiện</th>
                        <th>Thời Điểm (UTC)</th>
                    </tr>
                </thead>
                <tbody id="periodCloseLogBody">
                    <tr><td colspan="6" class="text-center text-muted">Đang tải lịch sử...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- TAB 3: NHẬP GIAO DỊCH & UNPIVOT             -->
<!-- ========================================== -->
<section class="tab-panel" id="tab-txn">
    <div class="panel-intro">
        <h2 class="intro-title">Nhập Giao Dịch & Nạp Dữ Liệu Bảng Rộng (UNPIVOT)</h2>
        <p class="intro-desc">
            Trải nghiệm hai luồng nghiệp vụ: Nhập giao dịch phát sinh qua thủ tục <code>sp_add_txn</code> (có kiểm soát lỗi nghiệp vụ và trigger) và Nạp dữ liệu Excel quý qua mệnh đề <code>UNPIVOT</code> trong <code>sp_load_wide</code>.
        </p>
    </div>

    <div class="grid-2col">
        <!-- Card 1: Nhập giao dịch đơn lẻ -->
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">1. Nhập Giao Dịch Đơn Lẻ</h3>
                    <span class="panel-subtitle">Gọi <code>pkg_bank_report.sp_add_txn</code></span>
                </div>
                <label class="test-mode-toggle" title="Bật để demo lỗi ORA-20003, ORA-20007 khi báo cáo">
                    <input type="checkbox" id="toggleTestMode" />
                    <span class="toggle-switch"></span>
                    <span class="toggle-text">Test biên lỗi Oracle</span>
                </label>
            </div>
            <div class="panel-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label for="txnBranch">Chi nhánh</label>
                        <select id="txnBranch" class="custom-select full-width"></select>
                    </div>
                    <div class="form-field">
                        <label for="txnProduct">Sản phẩm</label>
                        <select id="txnProduct" class="custom-select full-width"></select>
                    </div>
                </div>

                <div class="form-grid mt-3">
                    <div class="form-field">
                        <label for="txnItem">Khoản mục thu / chi</label>
                        <select id="txnItem" class="custom-select full-width"></select>
                    </div>
                    <div class="form-field">
                        <label for="txnPeriod">Kỳ báo cáo (YYYYMM)</label>
                        <input type="number" id="txnPeriod" class="custom-input full-width" value="202503" />
                        <small class="field-hint" id="txnPeriodHint">Gợi ý: Nhập <code>202402</code> để test lỗi nếu Q1-2024 đang chốt</small>
                    </div>
                </div>

                <div class="form-field mt-3">
                    <label for="txnAmount">Số tiền (triệu đồng)</label>
                    <input type="number" id="txnAmount" class="custom-input full-width" value="100" step="0.01" />
                    <small class="field-hint" id="txnAmountHint">Gợi ý: Nhập <code>-5</code> để test lỗi ORA-20007</small>
                </div>

                <button type="button" class="btn btn-primary full-width mt-4" id="btnAddTxn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Gửi Giao Dịch Vào Oracle</span>
                </button>
            </div>
        </div>

        <!-- Card 2: Nạp bảng rộng UNPIVOT -->
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">2. Nạp Bảng Rộng Excel (UNPIVOT)</h3>
                    <span class="panel-subtitle">Chèn vào <code>stg_income_wide</code> và gọi <code>sp_load_wide</code></span>
                </div>
            </div>
            <div class="panel-body">
                <p class="card-hint-text">
                    Mô phỏng file Excel tổng hợp theo 4 quý. Nhập số liệu cho từng quý; quý nào bỏ trống (NULL) sẽ được mệnh đề <code>UNPIVOT</code> của Oracle tự động loại bỏ.
                </p>

                <div class="form-grid">
                    <div class="form-field">
                        <label for="wideBranch">Chi nhánh</label>
                        <select id="wideBranch" class="custom-select full-width"></select>
                    </div>
                    <div class="form-field">
                        <label for="wideProduct">Sản phẩm</label>
                        <select id="wideProduct" class="custom-select full-width"></select>
                    </div>
                </div>

                <div class="form-grid mt-3">
                    <div class="form-field">
                        <label for="wideItem">Khoản mục</label>
                        <select id="wideItem" class="custom-select full-width"></select>
                    </div>
                    <div class="form-field">
                        <label for="wideYear">Năm tài chính</label>
                        <select id="wideYear" class="custom-select full-width">
                            <option value="2025" selected>2025</option>
                            <option value="2024">2024</option>
                        </select>
                    </div>
                </div>

                <div class="quarters-input-grid mt-3">
                    <div class="form-field">
                        <label for="wideQ1">Quý 1</label>
                        <input type="number" id="wideQ1" class="custom-input full-width" placeholder="Ví dụ: 120.5" step="0.01" />
                    </div>
                    <div class="form-field">
                        <label for="wideQ2">Quý 2</label>
                        <input type="number" id="wideQ2" class="custom-input full-width" placeholder="Ví dụ: 150.0" step="0.01" />
                    </div>
                    <div class="form-field">
                        <label for="wideQ3">Quý 3</label>
                        <input type="number" id="wideQ3" class="custom-input full-width" placeholder="Ví dụ: 180.2" step="0.01" />
                    </div>
                    <div class="form-field">
                        <label for="wideQ4">Quý 4</label>
                        <input type="number" id="wideQ4" class="custom-input full-width" placeholder="Bỏ trống = NULL" step="0.01" />
                    </div>
                </div>

                <button type="button" class="btn btn-success full-width mt-4" id="btnLoadWide">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <span>Thực Hiện UNPIVOT & Nạp Vào Fact</span>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- TAB 4: NHẬT KÝ & HỆ THỐNG                   -->
<!-- ========================================== -->
<section class="tab-panel" id="tab-logs">
    <div class="panel-intro">
        <h2 class="intro-title">Nhật Ký Kiểm Toán & Trạng Thái Hệ Thống</h2>
        <p class="intro-desc">
            Theo dõi nhật ký kiểm toán Trigger <code>trg_fact_audit</code>, kết quả 13 kịch bản kiểm thử tự động của Oracle 23ai (bảng <code>test_log</code>), và công cụ tra cứu lợi nhuận theo hàm <code>fn_net_income</code>.
        </p>
    </div>

    <!-- Tra cứu nhanh Lợi nhuận ròng -->
    <div class="panel-card mb-4">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">Tra Cứu Lợi Nhuận Ròng Chi Nhánh</h3>
                <span class="panel-subtitle">Gọi hàm <code>pkg_bank_report.fn_net_income(p_branch_id, p_year, p_quarter)</code></span>
            </div>
        </div>
        <div class="panel-body">
            <div class="quick-lookup-grid">
                <div class="form-field">
                    <label for="niBranch">Chi nhánh</label>
                    <select id="niBranch" class="custom-select full-width"></select>
                </div>
                <div class="form-field">
                    <label for="niYear">Năm</label>
                    <select id="niYear" class="custom-select full-width">
                        <option value="2025" selected>2025</option>
                        <option value="2024">2024</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="niQuarter">Quý</label>
                    <select id="niQuarter" class="custom-select full-width">
                        <option value="Q1" selected>Q1</option>
                        <option value="Q2">Q2</option>
                        <option value="Q3">Q3</option>
                        <option value="Q4">Q4</option>
                    </select>
                </div>
                <div class="form-field lookup-btn-field">
                    <button type="button" class="btn btn-primary full-width" id="btnNetIncome">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <span>Tính Lợi Nhuận</span>
                    </button>
                </div>
            </div>

            <div class="lookup-result-box" id="niResultBox" style="display:none;">
                <div class="res-title">Kết quả tính toán từ Oracle 23ai:</div>
                <div class="res-value" id="niResultValue">—</div>
            </div>
        </div>
    </div>

    <div class="grid-2col">
        <!-- Bảng Test Log Oracle -->
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">Kết Quả Kiểm Thử Oracle 23ai (test_log)</h3>
                    <span class="panel-subtitle">13 kịch bản kiểm thử T1–T9b tự động từ CSDL</span>
                </div>
                <button type="button" class="btn btn-xs btn-outline" id="btnRefreshTestLog">Làm mới</button>
            </div>
            <div class="table-scroll-wrap max-h-360">
                <table class="financial-table">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Mã</th>
                            <th>Kết Quả Thực Tế / Thông Báo Lỗi</th>
                        </tr>
                    </thead>
                    <tbody id="testLogBody">
                        <tr><td colspan="2" class="text-center text-muted">Đang tải kịch bản kiểm thử...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Trạng thái hệ thống -->
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">Thông Tin Kết Nối Cơ Sở Dữ Liệu</h3>
                    <span class="panel-subtitle">Thông số runtime kết nối container Docker</span>
                </div>
                <button type="button" class="btn btn-xs btn-outline" id="btnRefreshStatus">Làm mới</button>
            </div>
            <div class="panel-body" id="systemStatusDetails">
                <div class="status-loading">Đang tải thông tin hệ thống...</div>
            </div>
        </div>
    </div>

    <!-- Bảng Audit Log -->
    <div class="panel-card mt-4">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">Nhật Ký Kiểm Toán Biến Động (audit_log)</h3>
                <span class="panel-subtitle">Tự động ghi lại qua Trigger <code>trg_fact_audit</code> khi có UPDATE/DELETE</span>
            </div>
            <button type="button" class="btn btn-xs btn-outline" id="btnRefreshAudit">Làm mới</button>
        </div>
        <div class="table-scroll-wrap max-h-360">
            <table class="financial-table">
                <thead>
                    <tr>
                        <th>Log ID</th>
                        <th>Hành Động</th>
                        <th>Fact ID</th>
                        <th class="text-right">Số Tiền Cũ</th>
                        <th class="text-right">Số Tiền Mới</th>
                        <th>Người Thực Hiện</th>
                        <th>Thời Điểm</th>
                    </tr>
                </thead>
                <tbody id="auditLogBody">
                    <tr><td colspan="7" class="text-center text-muted">Đang tải nhật ký kiểm toán...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

