@{
    ViewData["Title"] = "Cổng Báo cáo Tài chính Hợp nhất";
}

<!-- ========================================== -->
<!-- TAB 1: TỔNG QUAN (DASHBOARD)               -->
<!-- ========================================== -->
<section class="tab-panel active" id="tab-dashboard">
    <!-- 4 KPI Cards -->
    <div class="kpi-grid">
        <!-- KPI 1: Revenue -->
        <div class="kpi-card kpi-card-primary">
            <div class="kpi-icon-wrapper icon-emerald">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
            </div>
            <div class="kpi-details">
                <span class="kpi-title">Tổng Thu Nhập</span>
                <div class="kpi-num-row">
                    <span class="kpi-number text-emerald" id="kpiRevenue">—</span>
                    <span class="kpi-unit">triệu ₫</span>
                </div>
                <span class="kpi-meta" id="kpiRevenueMeta">Tổng toàn hệ thống</span>
                <span class="kpi-change" id="kpiRevenueChange"></span>
            </div>
        </div>

        <!-- KPI 2: Expense -->
        <div class="kpi-card">
            <div class="kpi-icon-wrapper icon-rose">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline>
                    <polyline points="17 18 23 18 23 12"></polyline>
                </svg>
            </div>
            <div class="kpi-details">
                <span class="kpi-title">Tổng Chi Phí</span>
                <div class="kpi-num-row">
                    <span class="kpi-number text-rose" id="kpiExpense">—</span>
                    <span class="kpi-unit">triệu ₫</span>
                </div>
                <span class="kpi-meta" id="kpiExpenseMeta">Tổng toàn hệ thống</span>
                <span class="kpi-change" id="kpiExpenseChange"></span>
            </div>
        </div>

        <!-- KPI 3: Net Income -->
        <div class="kpi-card">
            <div class="kpi-icon-wrapper icon-blue">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </div>
            <div class="kpi-details">
                <span class="kpi-title">Lợi Nhuận Ròng</span>
                <div class="kpi-num-row">
                    <span class="kpi-number text-blue" id="kpiNetIncome">—</span>
                    <span class="kpi-unit">triệu ₫</span>
                </div>
                <span class="kpi-meta" id="kpiNetIncomeMeta">Thu nhập − Chi phí</span>
                <span class="kpi-change" id="kpiNetIncomeChange"></span>
            </div>
        </div>

        <!-- KPI 4: Locked quarters (clickable → tab-lock) -->
        <div class="kpi-card kpi-card-clickable" data-goto-tab="tab-lock" style="cursor:pointer;" title="Nhấn để xem chi tiết Khóa sổ Kế toán">
            <div class="kpi-icon-wrapper icon-purple">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <div class="kpi-details">
                <span class="kpi-title">Quý Đã Khóa Sổ</span>
                <div class="kpi-num-row">
                    <span class="kpi-number text-purple" id="kpiLocked">0</span>
                    <span class="kpi-unit">/ 8 quý</span>
                </div>
                <span class="kpi-meta" id="kpiLockedMeta">Nhấn để xem chi tiết</span>
            </div>
        </div>
    </div>

    <!-- Dashboard Control Bar -->
    <div class="control-bar-card">
        <div class="control-left">
            <span class="control-label">Năm tài chính:</span>
            <div class="year-select-wrap">
                <select id="dashYear" class="custom-select">
                    <option value="2025" selected>2025</option>
                    <option value="2024">2024</option>
                </select>
            </div>
        </div>
        <div class="control-right">
            <button type="button" class="btn btn-primary" id="btnRefreshDash" title="Làm mới dữ liệu Dashboard">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                <span>Làm mới</span>
            </button>
        </div>
    </div>

    <!-- Dashboard Charts Grid: 3 panels -->
    <div class="chart-grid-dashboard">
        <!-- Chart 1: Quarterly Combo -->
        <div class="panel-card chart-panel">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h3 class="panel-title">Xu hướng Thu – Chi – Lợi nhuận theo Quý</h3>
                    <span class="panel-subtitle">Biểu đồ kết hợp cột + đường</span>
                </div>
            </div>
            <div class="chart-content">
                <div class="chart-canvas-container">
                    <canvas id="chartQuarterly"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 2: Product Group Donut -->
        <div class="panel-card chart-panel">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h3 class="panel-title">Cơ cấu Lợi nhuận theo Nhóm SP</h3>
                    <span class="panel-subtitle">Biểu đồ tròn Donut</span>
                </div>
            </div>
            <div class="chart-content">
                <div class="chart-canvas-container">
                    <canvas id="chartProductGroup"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 3: Branch Ranking Horizontal Bar -->
        <div class="panel-card chart-panel">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h3 class="panel-title">Xếp hạng Lợi nhuận theo Chi nhánh</h3>
                    <span class="panel-subtitle">Biểu đồ thanh ngang</span>
                </div>
            </div>
            <div class="chart-content">
                <div class="chart-canvas-container">
                    <canvas id="chartBranchRanking"></canvas>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- TAB 2: BÁO CÁO OLAP                        -->
<!-- ========================================== -->
<section class="tab-panel" id="tab-report">
    <!-- Control Bar (mode buttons + year + actions) -->
    <div class="control-bar-card">
        <div class="control-left">
            <span class="control-label">Chế độ phân tích:</span>
            <div class="segmented-control" id="modeSegments">
                <button type="button" class="segment-btn active" data-mode="ROLLUP">
                    <span class="seg-title">ROLLUP</span>
                    <span class="seg-badge">Hợp nhất Phân cấp</span>
                </button>
                <button type="button" class="segment-btn" data-mode="CUBE">
                    <span class="seg-title">CUBE</span>
                    <span class="seg-badge">Phân tích Đa chiều</span>
                </button>
                <button type="button" class="segment-btn" data-mode="SETS">
                    <span class="seg-title">GROUPING SETS</span>
                    <span class="seg-badge">Tổng hợp Chọn lọc</span>
                </button>
                <button type="button" class="segment-btn" data-mode="PIVOT">
                    <span class="seg-title">PIVOT</span>
                    <span class="seg-badge">So sánh Quý</span>
                </button>
                <button type="button" class="segment-btn" data-mode="PIVOT_DYN">
                    <span class="seg-title">PIVOT Động</span>
                    <span class="seg-badge">Cơ cấu Sản phẩm</span>
                </button>
            </div>
        </div>

        <div class="control-right">
            <div class="year-select-wrap">
                <label for="reportYear" class="control-label">Năm:</label>
                <select id="reportYear" class="custom-select">
                    <option value="2025" selected>2025</option>
                    <option value="2024">2024</option>
                </select>
            </div>

            <button type="button" class="btn btn-primary" id="btnRefreshReport" title="Tải lại dữ liệu">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                <span>Làm mới</span>
            </button>

            <button type="button" class="btn btn-outline" id="btnPrintReport" title="In báo cáo">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span>In</span>
            </button>

            <button type="button" class="btn btn-outline" id="btnToggleSql" title="Hiện/Ẩn câu SQL">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                <span>SQL</span>
            </button>
        </div>
    </div>

    <!-- SQL Info Panel (hidden by default) -->
    <div class="panel-card" id="sqlInfoPanel" style="display:none;">
        <div class="panel-header">
            <div class="panel-title-group">
                <h3 class="panel-title">Câu lệnh SQL đang thực thi</h3>
                <span class="panel-subtitle">Chế độ phân tích hiện tại từ Oracle 23ai</span>
            </div>
        </div>
        <div class="panel-body">
            <pre class="sql-display" id="sqlDisplay" style="white-space:pre-wrap; font-family:monospace; font-size:0.85rem; padding:1rem; background:var(--surface-secondary); border-radius:8px; overflow-x:auto;"></pre>
        </div>
    </div>

    <!-- Analytics Chart Card -->
    <div class="panel-card chart-panel">
        <div class="panel-header">
            <div class="panel-title-group">
                <h3 class="panel-title" id="chartTitle">Biểu Đồ Phân Tích Lợi Nhuận Ròng</h3>
                <span class="panel-subtitle" id="chartSubtitle">So sánh chi tiết từ tập dữ liệu Oracle 23ai</span>
            </div>
            <button class="btn btn-sm btn-ghost" id="btnToggleChart" title="Thu gọn biểu đồ">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="18 15 12 9 6 15"></polyline>
                </svg>
                <span id="chartToggleText">Thu gọn</span>
            </button>
        </div>
        <div class="chart-content" id="chartContent">
            <div class="chart-canvas-container">
                <canvas id="reportChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Financial Data Table Card -->
    <div class="panel-card table-panel">
        <div class="panel-header">
            <div class="panel-title-group">
                <div class="title-with-badge">
                    <h3 class="panel-title">Dữ Liệu Chi Tiết Báo Cáo</h3>
                    <span class="count-badge" id="tableRowCountBadge">0 dòng</span>
                </div>
                <span class="panel-subtitle">Dữ liệu hợp nhất từ package <code>pkg_bank_report.fn_report</code></span>
            </div>

            <div class="panel-actions">
                <div class="search-input-wrap">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" class="search-input" id="tableSearch" placeholder="Lọc chi nhánh, khu vực, quý..." />
                </div>
                <button type="button" class="btn btn-sm btn-outline" id="btnExportCsv" title="Xuất CSV chuẩn UTF-8">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>CSV</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline" id="btnExportExcel" title="Xuất file Excel tương thích UTF-8 BOM">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>Excel</span>
                </button>
            </div>
        </div>

        <div class="table-scroll-wrap" id="tableScrollWrap">
            <!-- Skeleton Loader -->
            <div class="skeleton-container" id="reportSkeleton">
                <div class="sk-row sk-header"></div>
                <div class="sk-row"></div>
                <div class="sk-row"></div>
                <div class="sk-row"></div>
                <div class="sk-row"></div>
                <div class="sk-row"></div>
                <div class="sk-row"></div>
            </div>

            <!-- Table -->
            <table class="financial-table" id="reportTable" style="display:none;">
                <thead id="reportThead"></thead>
                <tbody id="reportTbody"></tbody>
            </table>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- TAB 3: SỔ GIAO DỊCH                        -->
<!-- ========================================== -->
<section class="tab-panel" id="tab-txn">
    <div class="panel-intro">
        <h2 class="intro-title">Sổ Giao Dịch &amp; Nạp Dữ Liệu Bảng Rộng (UNPIVOT)</h2>
        <p class="intro-desc">
            Quản lý giao dịch phát sinh qua thủ tục <code>sp_add_txn</code> và Nạp dữ liệu Excel quý qua mệnh đề <code>UNPIVOT</code> trong <code>sp_load_wide</code>.
        </p>
    </div>

    <!-- Sub-tabs -->
    <div class="sub-tab-bar">
        <button type="button" class="sub-tab-btn active" data-subtab="subtab-txn-list">Danh sách Giao dịch</button>
        <button type="button" class="sub-tab-btn" data-subtab="subtab-txn-wide">Nạp bảng rộng UNPIVOT</button>
    </div>

    <!-- Sub-tab 1: Transaction List -->
    <div class="sub-tab-panel active" id="subtab-txn-list">
        <!-- Filter Bar -->
        <div class="control-bar-card">
            <div class="control-left" style="flex-wrap:wrap; gap:0.5rem;">
                <div class="year-select-wrap">
                    <label for="txnFilterBranch" class="control-label">Chi nhánh:</label>
                    <select id="txnFilterBranch" class="custom-select">
                        <option value="">Tất cả</option>
                    </select>
                </div>
                <div class="year-select-wrap">
                    <label for="txnFilterYear" class="control-label">Năm:</label>
                    <select id="txnFilterYear" class="custom-select">
                        <option value="" selected>Tất cả</option>
                        <option value="2025">2025</option>
                        <option value="2024">2024</option>
                    </select>
                </div>
                <div class="year-select-wrap">
                    <label for="txnFilterQuarter" class="control-label">Quý:</label>
                    <select id="txnFilterQuarter" class="custom-select">
                        <option value="" selected>Tất cả</option>
                        <option value="Q1">Q1</option>
                        <option value="Q2">Q2</option>
                        <option value="Q3">Q3</option>
                        <option value="Q4">Q4</option>
                    </select>
                </div>
                <div class="search-input-wrap">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" class="search-input" id="txnSearchInput" placeholder="Tìm sản phẩm, khoản mục..." />
                </div>
            </div>
            <div class="control-right">
                <button type="button" class="btn btn-primary" id="btnSearchTxn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <span>Tìm kiếm</span>
                </button>
                <button type="button" class="btn btn-success" id="btnOpenAddTxn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Thêm giao dịch</span>
                </button>
            </div>
        </div>

        <!-- Transaction Table -->
        <div class="panel-card table-panel">
            <div class="table-scroll-wrap">
                <table class="financial-table" id="txnTable">
                    <thead>
                        <tr>
                            <th>Fact ID</th>
                            <th>Chi nhánh</th>
                            <th>Vùng</th>
                            <th>Sản phẩm</th>
                            <th>Nhóm SP</th>
                            <th>Khoản mục</th>
                            <th>Năm</th>
                            <th>Quý</th>
                            <th class="text-right">Số tiền</th>
                            <th class="text-right">Ròng</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="txnTbody">
                        <tr><td colspan="11" class="text-center text-muted">Nhấn "Tìm kiếm" để tải dữ liệu giao dịch</td></tr>
                    </tbody>
                </table>
            </div>
            <!-- Pagination -->
            <div class="pagination-bar" id="txnPagination">
                <!-- Rendered by JS -->
            </div>
        </div>
    </div>

    <!-- Sub-tab 2: Wide Load UNPIVOT -->
    <div class="sub-tab-panel" id="subtab-txn-wide">
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">Nạp Bảng Rộng Excel (UNPIVOT)</h3>
                    <span class="panel-subtitle">Chèn vào <code>stg_income_wide</code> và gọi <code>sp_load_wide</code></span>
                </div>
            </div>
            <div class="panel-body">
                <p class="card-hint-text">
                    Mô phỏng file Excel tổng hợp theo 4 quý. Nhập số liệu cho từng quý; quý nào bỏ trống (NULL) sẽ được mệnh đề <code>UNPIVOT</code> của Oracle tự động loại bỏ.
                </p>

                <div class="form-grid">
                    <div class="form-field">
                        <label for="wideBranch">Chi nhánh</label>
                        <select id="wideBranch" class="custom-select full-width"></select>
                    </div>
                    <div class="form-field">
                        <label for="wideProduct">Sản phẩm</label>
                        <select id="wideProduct" class="custom-select full-width"></select>
                    </div>
                </div>

                <div class="form-grid mt-3">
                    <div class="form-field">
                        <label for="wideItem">Khoản mục</label>
                        <select id="wideItem" class="custom-select full-width"></select>
                    </div>
                    <div class="form-field">
                        <label for="wideYear">Năm tài chính</label>
                        <select id="wideYear" class="custom-select full-width">
                            <option value="2025" selected>2025</option>
                            <option value="2024">2024</option>
                        </select>
                    </div>
                </div>

                <div class="quarters-input-grid mt-3">
                    <div class="form-field">
                        <label for="wideQ1">Quý 1</label>
                        <input type="number" id="wideQ1" class="custom-input full-width" placeholder="Ví dụ: 120.5" step="0.01" />
                    </div>
                    <div class="form-field">
                        <label for="wideQ2">Quý 2</label>
                        <input type="number" id="wideQ2" class="custom-input full-width" placeholder="Ví dụ: 150.0" step="0.01" />
                    </div>
                    <div class="form-field">
                        <label for="wideQ3">Quý 3</label>
                        <input type="number" id="wideQ3" class="custom-input full-width" placeholder="Ví dụ: 180.2" step="0.01" />
                    </div>
                    <div class="form-field">
                        <label for="wideQ4">Quý 4</label>
                        <input type="number" id="wideQ4" class="custom-input full-width" placeholder="Bỏ trống = NULL" step="0.01" />
                    </div>
                </div>

                <button type="button" class="btn btn-success full-width mt-4" id="btnLoadWide">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <span>Thực Hiện UNPIVOT &amp; Nạp Vào Fact</span>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- TAB 4: KHÓA SỔ KẾ TOÁN                     -->
<!-- ========================================== -->
<section class="tab-panel" id="tab-lock">
    <div class="panel-intro">
        <h2 class="intro-title">Quản lý Chốt kỳ &amp; Khóa Dữ liệu Tài chính</h2>
        <p class="intro-desc">
            Khi thực hiện Chốt quý, hệ thống tự động khóa <code>LOCK TABLE fact_income IN SHARE MODE WAIT 10</code> và kích hoạt Trigger bảo vệ <code>trg_fact_period_guard</code> để ngăn chặn tuyệt đối mọi hành vi thêm, sửa hoặc xóa dữ liệu của quý đã khóa.
        </p>
    </div>

    <!-- 8-Quarter Visual Grid -->
    <div class="panel-card mb-4">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">Trạng Thái 8 Quý (2024 – 2025)</h3>
                <span class="panel-subtitle">Nhấn vào quý để xem chi tiết · Xanh = Mở · Đỏ = Đã khóa</span>
            </div>
            <button type="button" class="btn btn-xs btn-outline" id="btnRefreshQuarterGrid">Làm mới</button>
        </div>
